# Set these in Vercel → Project → Settings → Environment Variables
ADMIN_PASSWORD=choose-a-long-password

# Added automatically when you connect a database from Vercel's Storage tab.
# "Redis" (Redis Cloud) adds this one:
REDIS_URL=

# "Upstash for Redis" adds these instead:
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
